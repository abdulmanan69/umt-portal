{
  "manifest_version": 3,
  "name": "UMT Portal \u00e2\u20ac\u201d Reimagined",
  "version": "1.0.0",
  "description": "A faster, clearer, fully responsive interface for the UMT Student Portal, with a live academic overview built from your own records.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "UMT Portal \u00e2\u20ac\u201d Reimagined",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://online.umt.edu.pk/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://online.umt.edu.pk/*"
      ],
      "css": [
        "src/theme.css"
      ],
      "js": [
        "src/core.js",
        "src/data.js",
        "src/shell.js",
        "src/widgets.js",
        "src/pages.js",
        "src/export.js",
        "src/boot.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2",
        "icons/*.png"
      ],
      "matches": [
        "https://online.umt.edu.pk/*"
      ]
    }
  ],
  "author": "Abdul Manan",
  "homepage_url": "https://github.com/abdulmanan69/umt-portal"
}
